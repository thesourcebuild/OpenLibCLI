# OpenLibCLI source package: version check for find_package(). The package scripts
# replace @OPENLIBCLI_VERSION@ with the contents of the 'version' file.
set(PACKAGE_VERSION "@OPENLIBCLI_VERSION@")

# Same major version and not older than requested (CMake's SameMajorVersion rule).
string(REGEX MATCH "^[0-9]+" _openlibcli_major "${PACKAGE_VERSION}")
if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
elseif(NOT "${PACKAGE_FIND_VERSION}" STREQUAL "" AND
       NOT PACKAGE_FIND_VERSION_MAJOR STREQUAL _openlibcli_major)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
unset(_openlibcli_major)
