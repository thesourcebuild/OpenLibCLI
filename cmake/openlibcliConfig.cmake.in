@PACKAGE_INIT@

# Imported targets of the installed library:
#   OpenLibCLI::OpenLibCLI         shared library
#   OpenLibCLI::OpenLibCLI_static  static library (when built with BUILD_LIB_STATIC)
include("${CMAKE_CURRENT_LIST_DIR}/openlibcliTargets.cmake")

# The name find_package() was called with (OpenLibCLI or openlibcli).
check_required_components(${CMAKE_FIND_PACKAGE_NAME})
